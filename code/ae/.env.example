# Always Encrypted - Connection & Azure Key Vault settings
# Copy this file to .env and fill in your values.
# Script 51 (Setup Azure Key Vault) will write these automatically
# if .env exists or will create it.

# SQL Server connection
SQL_SERVER=localhost,1433
SQL_DATABASE=AETest
SQL_USER=sa
SQL_PASSWORD=

# Azure Key Vault (populated by script 51)
AKV_TENANT_ID=
AKV_CLIENT_ID=
AKV_CLIENT_SECRET=
AKV_KEY_URL=
AKV_VAULT_NAME=
